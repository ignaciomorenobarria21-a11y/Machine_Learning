        "# ============================================================\n",
        "# SELECCIÓN DE FEATURES CON RANDOM FOREST\n",
        "# ============================================================\n",
        "\n",
        "# Identificar columnas de features (excluir Date y Targets)\n",
        "cols_excluir = ['Date', 'Target_Return', 'Target_Direccion', 'Open', 'High', 'Low', 'Close', 'Volume']\n",
        "feature_cols = [col for col in df_train_clean.columns if col not in cols_excluir]\n",
        "\n",
        "print(f\"📊 Total de features disponibles: {len(feature_cols)}\")\n",
        "\n",
        "# Preparar datos para selección de features\n",
        "X_seleccion = df_train_clean[feature_cols]\n",
        "y_seleccion = df_train_clean['Target_Direccion']\n",
        "\n",
        "# Entrenar RF rápido para calcular importancias\n",
        "print(\"\\n⏳ Entrenando Random Forest para calcular importancias...\")\n",
        "rf_selector = RandomForestClassifier(\n",
        "    n_estimators=100,    # 100 árboles (suficiente para importancias)\n",
        "    max_depth=5,         # Árboles poco profundos (rápido)\n",
        "    random_state=42,\n",
        "    n_jobs=-1            # Usar todos los núcleos\n",
        ")\n",
        "rf_selector.fit(X_seleccion, y_seleccion)\n",
        "print(\"✅ Random Forest entrenado\")\n",
        "\n",
        "# Crear DataFrame con importancias\n",
        "importancias = pd.DataFrame({\n",
        "    'Feature': feature_cols,\n",
        "    'Importancia': rf_selector.feature_importances_\n",
